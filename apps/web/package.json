{
  "name": "@adminsecops/web",
  "version": "0.1.0",
  "private": true,
  "description": "AdminSecOps web dashboard: local mode (with the local API) and hosted browser-only mode.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "preview": "vite preview",
    "build:hosted": "tsc -p tsconfig.json --noEmit && vite build --mode hosted",
    "preview:hosted": "vite preview --mode hosted --outDir dist-hosted"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^29.1.1",
    "vite": "^8.3.0"
  }
}
