{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["vite/client", "node"],
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "composite": false,
    "incremental": false,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "paths": {
      "@adminsecops/schemas": ["../../packages/schemas/src/index.ts"],
      "@adminsecops/core": ["../../packages/core/src/index.ts"],
      "@adminsecops/core/vocabulary": ["../../packages/core/src/vocabulary.ts"],
      "@adminsecops/core/version": ["../../packages/core/src/version.ts"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "vite.config.ts", "vitest.config.ts"]
}
